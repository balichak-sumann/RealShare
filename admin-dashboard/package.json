{
  "name": "admin-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production node server.js",
    "start:cpanel": "NODE_ENV=production node server.js",
    "lint": "eslint",
    "zip": "npm run build && cd .. && zip -q -r admin-dashboard-deploy.zip admin-dashboard -x \"admin-dashboard/node_modules/*\" -x \"admin-dashboard/.git/*\" -x \"admin-dashboard/.vscode/*\" && echo '✅ Deployment ZIP created at Desktop/RealShare/admin-dashboard-deploy.zip'"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/leaflet": "^1.9.22",
    "@types/nodemailer": "^8.0.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "leaflet": "^1.9.4",
    "next": "16.3.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^7.10.0",
