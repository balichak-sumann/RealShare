generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                   String        @id
  full_name            String
  email                String?       @unique
  phone_number         String?
  role                 String        @default("investor")
  employee_department  String?       // "sales", "support", or "accounts"
  avatar_url           String?
  wallet_balance       Decimal       @default(0.00) @db.Decimal(15, 2)
  kyc_status           String        @default("not_submitted")
  kyc_rejection_reason String?
  referral_code        String?       @unique
  referred_by_code     String?
  expo_push_token      String?
  is_active            Boolean       @default(true)
  is_banned            Boolean       @default(false)
  bank_account_name    String?
  bank_account_number  String?
  bank_ifsc            String?
  commission_rate_pct  Decimal?      @db.Decimal(5, 2) // agent commission rate, admin-settable
  created_at           DateTime      @default(now()) @db.Timestamptz(6)
  updated_at           DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  // Relations
  kyc_documents             KycDocument[]
  posted_properties         Property[]
  investments               Investment[]
  transactions              Transaction[] @relation("UserTransactions")
  verified_kyc_docs         KycDocument[] @relation("VerifiedByProfile")
  agent_commissions         AgentCommission[] @relation("AgentCommissions")
  investor_commissions      AgentCommission[] @relation("InvestorCommissions")
  
  assigned_sales_rep_id     String?
  assigned_sales_rep        Profile?          @relation("SalesAssignment", fields: [assigned_sales_rep_id], references: [id])
  assigned_clients          Profile[]         @relation("SalesAssignment")
  agent_clients             AgentClient[]     @relation("AgentClients")
  chat_messages             ChatMessage[]

  @@map("profiles")
}

model KycDocument {
  id                  String    @id @default(uuid()) @db.Uuid
  user_id             String
  document_type       String
  document_number     String
  document_front_url  String    @default("")
  document_back_url   String?
  verification_status String    @default("pending")
  rejection_reason    String?
  verified_by         String?
  verified_at         DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)

  // Relations
  profile          Profile  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  verified_by_user Profile? @relation("VerifiedByProfile", fields: [verified_by], references: [id])

  @@unique([user_id, document_type])
  @@map("kyc_documents")
}

model Property {
  id                  String    @id @default(uuid()) @db.Uuid
  title               String
  description         String?
  property_type       String
  listing_type        String    @default("fractional") // "fractional" | "outright"
  total_fractions     Int
  available_fractions Int
  sold_fractions      Int       @default(0)
  price_per_fraction  Decimal   @db.Decimal(12, 2)
  booking_amount      Decimal   @default(50000.00) @db.Decimal(12, 2)
  assured_yield       Decimal?  @db.Decimal(5, 2)
  target_irr          Decimal?  @db.Decimal(5, 2)
  state               String
  district            String
  locality            String
  full_address        String?
  lat                 Decimal?  @db.Decimal(10, 6)
  lng                 Decimal?  @db.Decimal(10, 6)
  video_url           String?
  brochure_url        String?
  posted_by           String?
  developer_id        String?   @db.Uuid
  approval_status     String    @default("pending_approval")
  rejection_notes     String?
  featured            Boolean   @default(false)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  // Relations
  profile           Profile?          @relation(fields: [posted_by], references: [id])
  developer         Developer?        @relation(fields: [developer_id], references: [id])
  images            PropertyImage[]
  investments       Investment[]
  transactions      Transaction[]
  agent_commissions AgentCommission[]
  agent_client_assignments AgentClientProperty[]

  @@map("properties")
}

model PropertyImage {
  id          String   @id @default(uuid()) @db.Uuid
  property_id String   @db.Uuid
  image_url   String
  is_primary  Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  property Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@map("property_images")
}

model Investment {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String
  property_id         String   @db.Uuid
  fractions_bought    Int
  total_amount        Decimal  @db.Decimal(15, 2)
  booking_amount_paid Decimal  @db.Decimal(15, 2)
  ownership_percentage Decimal @db.Decimal(6, 3)
  certificate_number  String?  @unique
  status              String   @default("completed")
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  profile           Profile           @relation(fields: [user_id], references: [id])
  property          Property          @relation(fields: [property_id], references: [id])
  transactions      Transaction[]
  agent_commissions AgentCommission[]

  @@map("investments")
}

model Transaction {
  id               String   @id @default(uuid()) @db.Uuid
  user_id          String
  property_id      String?  @db.Uuid
  investment_id    String?  @db.Uuid
  transaction_type String
  amount           Decimal  @db.Decimal(15, 2)
  currency         String   @default("INR")
  payment_gateway  String?  @default("Razorpay")
  gateway_txn_id   String?
  payment_method   String?
  payment_status   String   @default("pending")
  metadata         Json?
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  profile    Profile     @relation("UserTransactions", fields: [user_id], references: [id])
  property   Property?   @relation(fields: [property_id], references: [id])
  investment Investment? @relation(fields: [investment_id], references: [id])

  @@map("transactions")
}

model AgentCommission {
  id                    String   @id @default(uuid()) @db.Uuid
  agent_id              String
  investor_id           String
  property_id           String   @db.Uuid
  investment_id         String   @db.Uuid
  commission_percentage Decimal  @default(2.00) @db.Decimal(5, 2)
  commission_amount     Decimal  @db.Decimal(15, 2)
  status                String   @default("pending_clearance")
  paid_at               DateTime? @db.Timestamptz(6)
  created_at            DateTime @default(now()) @db.Timestamptz(6)

  agent      Profile    @relation("AgentCommissions", fields: [agent_id], references: [id])
  investor   Profile    @relation("InvestorCommissions", fields: [investor_id], references: [id])
  property   Property   @relation(fields: [property_id], references: [id])
  investment Investment @relation(fields: [investment_id], references: [id])

  @@map("agent_commissions")
}

model AgentClient {
  id             String   @id @default(uuid()) @db.Uuid
  agent_id       String
  client_name    String
  phone_number   String
  target_budget  String?
  status         String   @default("Hot Lead")
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  agent          Profile  @relation("AgentClients", fields: [agent_id], references: [id])
  assignments    AgentClientProperty[]
  chat_messages  ChatMessage[]

  @@map("agent_clients")
}

model AgentClientProperty {
  id             String   @id @default(uuid()) @db.Uuid
  client_id      String   @db.Uuid
  property_id    String   @db.Uuid
  assigned_at    DateTime @default(now()) @db.Timestamptz(6)

  client         AgentClient @relation(fields: [client_id], references: [id], onDelete: Cascade)
  property       Property    @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@unique([client_id, property_id])
  @@map("agent_client_properties")
}

model ChatMessage {
  id          String   @id @default(uuid()) @db.Uuid
  agent_id    String
  client_id   String   @db.Uuid
  message     String
  sender      String   // "agent" or "client"
  read        Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  agent       Profile     @relation(fields: [agent_id], references: [id])
  client      AgentClient @relation(fields: [client_id], references: [id])

  @@map("chat_messages")
}

model Developer {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  logo_url          String?
  bio               String?
  rating            Decimal   @default(4.5) @db.Decimal(2, 1)
  established_year  Int?
  rera_registered   Boolean   @default(true)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)

  properties Property[]

  @@map("developers")
}

model Notification {
  id               String   @id @default(uuid()) @db.Uuid
  title            String
  body             String
  audience         String   @default("all") // "all" | "investors" | "agents" | "builders"
  sent_by          String?
  recipients_count Int      @default(0)
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  @@map("notifications")
}

model Banner {
  id         String   @id @default(uuid()) @db.Uuid
  title      String
  subtitle   String?
  badge      String?
  image_url  String
  link_url   String?
  is_active  Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("banners")
}

model ServiceInquiry {
  id                  String   @id @default(uuid()) @db.Uuid
  customer_name       String
  phone               String?
  email               String?
  service_type        String
  property_reference  String?
  estimated_budget    String?
  assigned_to         String?
  status              String   @default("New")
  notes               String?
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  @@map("service_inquiries")
}

model SupportTicket {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String
  ticket_number  String   @unique
  category       String
  subject        String
  description    String
  priority       String   @default("medium")
  status         String   @default("open")
  assigned_to    String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("support_tickets")
}

model Shortlist {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String
  property_id String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([user_id, property_id])
  @@map("shortlists")
}

model PlatformSetting {
  id         String   @id @default("global")
  values     Json
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("platform_settings")
}
