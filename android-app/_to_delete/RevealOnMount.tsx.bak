import React, { useEffect } from 'react';
import { StyleProp, ViewStyle } from 'react-native';
import Animated, {
  useSharedValue,
  useAnimatedStyle,
  withDelay,
  withSpring,
} from 'react-native-reanimated';
import { Motion } from '@/constants/design';

interface RevealOnMountProps {
  children: React.ReactNode;
  /** Index within a staggered list -- delay = min(index, maxItems) * step. Ignored if `delay` is set. */
  index?: number;
  /** Explicit delay in ms, overrides index-derived delay. */
  delay?: number;
  style?: StyleProp<ViewStyle>;
  /** Change this value (e.g. a fetched-data identity or refresh counter) to replay the reveal. */
  trigger?: unknown;
}

/**
 * Subtle fade + slight-rise entrance for cards and sections, generalizing
 * TabAnimationWrapper's once-per-tab-focus entrance into a reusable,
 * lower-intensity primitive (16px translate, no forced rotateX tilt) meant
 * to be used many times per screen -- on individual cards in a list, or on
 * each major section of a page -- rather than once per tab.
 *
 * TabAnimationWrapper itself is untouched; it's a different, stronger,
 * once-per-screen effect and stays that way.
 */
export function RevealOnMount({ children, index = 0, delay, style, trigger }: RevealOnMountProps) {
  const progress = useSharedValue(0);
  const computedDelay = delay ?? Math.min(index, Motion.stagger.maxItems) * Motion.stagger.step;

  useEffect(() => {
    progress.value = 0;
    progress.value = withDelay(computedDelay, withSpring(1, Motion.spring.entrance));
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [trigger]);

  const animStyle = useAnimatedStyle(() => ({
    opacity: progress.value,
    transform: [{ translateY: (1 - progress.value) * Motion.translate.entranceY }],
  }));

  return <Animated.View style={[animStyle, style]}>{children}</Animated.View>;
}

export default RevealOnMount;
