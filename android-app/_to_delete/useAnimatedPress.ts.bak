import { useSharedValue, useAnimatedStyle, withSpring } from 'react-native-reanimated';
import { Motion } from '@/constants/design';

/**
 * Shared press-feedback animation used across all "card" and "button" style
 * pressables (PremiumCard, GoldButton, CategoryPill, ServicesStrip's
 * AnimatedServiceItem, ...). Consolidates four previously-independent,
 * copy-pasted Animated.spring implementations into one Reanimated-based
 * primitive so press feedback feels identical everywhere.
 *
 * Usage:
 *   const { style, onPressIn, onPressOut } = useAnimatedPress();
 *   <Animated.View style={style}>
 *     <Pressable onPressIn={onPressIn} onPressOut={onPressOut} onPress={...}>
 *       ...
 *     </Pressable>
 *   </Animated.View>
 */
export function useAnimatedPress(scaleTo: number = Motion.scale.pressSubtle) {
  const scale = useSharedValue(1);

  const style = useAnimatedStyle(() => ({
    transform: [{ scale: scale.value }],
  }));

  const onPressIn = () => {
    scale.value = withSpring(scaleTo, Motion.spring.press);
  };

  const onPressOut = () => {
    scale.value = withSpring(1, Motion.spring.press);
  };

  return { style, onPressIn, onPressOut };
}

export default useAnimatedPress;
