{
  "expo": {
    "name": "Realshare",
    "slug": "realshare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/realshare-logo.png",
    "scheme": "androidapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.realshare.app",
      "icon": "./assets/images/realshare-logo.png",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.realshare.app",
      "versionCode": 22,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/realshare-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Realshare needs access to your photos so you can upload profile pictures and property images.",
          "cameraPermission": "Realshare needs access to your camera so you can take photos of properties."
        }
      ],
      [
        "expo-document-picker",
        {
          "appleTeamId": "433XX9DAR2"
        }
      ],
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "a786e55d-d4ef-40bd-8d1c-844f5dff4a81"
      }
    }
  }
}
